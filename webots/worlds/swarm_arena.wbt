# ---- circular pillars --------------------------------------------------------
DEF PILLAR_A Solid {
  translation 12 0.4 14
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.3 0.3 0.33 } }
      geometry Cylinder { radius 1.2 height 0.8 }
    }
  ]
  name "pillar_a"
  boundingObject Cylinder { radius 1.2 height 0.8 }
}
DEF PILLAR_B Solid {
  translation 24 0.4 10
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.3 0.3 0.33 } }
      geometry Cylinder { radius 1 height 0.8 }
    }
  ]
  name "pillar_b"
  boundingObject Cylinder { radius 1 height 0.8 }
}
# ---- swarm robot template (instantiated 5x below) ----------------------------
# local frame: +x forward, +y up, +z to the LEFT; wheels at z = +-0.08 m
# ---- agent 0: coordinator, centre spawn --------------------------------------
DEF SWARM_0 Robot {
  translation 15 0.033 15
  rotation 0 1 0 0
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.8 0.2 0.2 } }
      geometry Box { size 0.30 0.10 0.35 }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 0.08 }
      device [ RotationalMotor { name "left_wheel" maxVelocity 25 } ]
      endPoint Solid {
        translation 0 0 0.08
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
            geometry Cylinder { radius 0.033 height 0.02 }
          }
        ]
        name "left_wheel"
        boundingObject Cylinder { radius 0.033 height 0.02 }
        physics Physics { density -1 mass 0.1 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 -0.08 }
      device [ RotationalMotor { name "right_wheel" maxVelocity 25 } ]
      endPoint Solid {
        translation 0 0 -0.08
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
            geometry Cylinder { radius 0.033 height 0.02 }
          }
        ]
        name "right_wheel"
        boundingObject Cylinder { radius 0.033 height 0.02 }
        physics Physics { density -1 mass 0.1 }
      }
    }
    BallJoint {
      jointParameters BallJointParameters { anchor 0 -0.017 -0.14 }
      endPoint Solid {
        translation 0 -0.017 -0.14
        children [
          Shape {
            appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 } }
            geometry Sphere { radius 0.016 }
          }
        ]
        name "caster"
        boundingObject Sphere { radius 0.016 }
        physics Physics { density -1 mass 0.02 }
      }
    }
    Lidar {
      translation 0 0.07 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.2 0.2 0.2 } }
          geometry Cylinder { radius 0.03 height 0.05 }
        }
      ]
      name "lidar"
      type "fixed"
      fieldOfView 6.28318
      horizontalResolution 90
      numberOfLayers 1
      minRange 0.05
      maxRange 8
      noise 0.02
    }
    GPS { translation 0 0.08 0 name "gps" }
    Compass { translation 0 0.09 0 name "compass" }
    Emitter {
      translation 0 0.09 0
      name "emitter"
      type "radio"
      channel 1
      range 6
    }
    Receiver {
      translation 0 0.09 0
      name "receiver"
      type "radio"
      channel 1
    }
  ]
  name "swarm_0"
  controller "swarm_controller"
  controllerArgs [ "0" ]
  boundingObject Box { size 0.30 0.10 0.35 }
  physics Physics { density -1 mass 1.2 }
}
