#VRML_SIM V2023b utf8
# Component B world: 30 m x 30 m swarm arena mirroring
# component_b/swarm/environment.py (make_swarm_arena).
# Five identical differential-drive robots (wheel radius 0.033 m, track
# 0.16 m), one per SPAWN_POSES entry. Robot 0 ("swarm_0") is the logical
# coordinator; hardware and controller code are identical for all agents.
# Each robot carries: 360-deg LiDAR (obstacle probing), GPS + Compass
# (pose stand-in for localization), and Emitter/Receiver radios with a
# 6 m range that reproduce the unit-disc communication topology of the
# Python swarm simulation (range field = CommunicationNetwork radius).

WorldInfo {
  coordinateSystem "ENU"
  basicTimeStep 40
}
Viewpoint {
  orientation -0.3 0.8 0.5 1.1
  position -8 25 -8
}
Background {
  skyColor [ 0.55 0.75 0.95 ]
}
DEF FLOOR Solid {
  translation 15 0 15
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.92 0.92 0.92 }
      }
      geometry Box { size 30.6 0.1 30.6 }
    }
  ]
  name "floor"
  boundingObject Box { size 30.6 0.1 30.6 }
}
# ---- border walls (0.3 m thick, mirrors add_border_walls(0.3)) --------------
DEF SW_WALL_S Solid {
  translation 15 0.25 0.15
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.4 0.4 0.45 } }
      geometry Box { size 30.6 0.5 0.3 }
    }
  ]
  name "wall_s"
  boundingObject Box { size 30.6 0.5 0.3 }
}
